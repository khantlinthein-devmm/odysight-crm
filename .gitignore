# Environment / secrets — never commit real values
.env
.env.*
!.env.example
!apps/api/.env.example
!apps/web/.env.example

# Local run artifacts
*.pid
*.log
*.exe~
api-test*

# Test output
test-results/

# Editor/OS
.DS_Store
.idea/
.vscode/
# Production data — lives on the server / in volumes, never in git
backups/
*.dump
*.sql.gz
uploads/

# TLS certificates and private keys
certs/
*.pem
*.key
*.crt

# Local/server-only compose overrides (may hold secrets or host ports)
docker-compose.override.yml

# Test / coverage reports
playwright-report/
coverage/
