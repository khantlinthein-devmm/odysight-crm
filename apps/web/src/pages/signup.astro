---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Sign up">
  <div class="w-full max-w-md px-4">
    <div class="mb-8 flex flex-col items-center gap-3">
      <a
        href="/"
        class="block"
        aria-label="Back to home"
      >
        <img
          src="/logo/logo.png"
          alt="Odysight logo"
          class="h-16 w-16 rounded-2xl bg-white object-contain shadow-sm ring-1 ring-gray-200"
        />
      </a>
      <div class="text-center">
        <h1 class="text-2xl font-semibold text-gray-900">
          Create your account
        </h1>
        <p class="mt-1 text-sm text-gray-500">
          Request access to Odysight CRM
        </p>
      </div>
    </div>

    <form
      id="signup-form"
      class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm"
    >
      <div class="space-y-4">
        <div>
          <label
            class="mb-1 block text-sm font-medium text-gray-700"
            for="name">Full name</label
          >
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Jane Doe"
            class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-navy-500"
          />
        </div>

        <div>
          <label
            class="mb-1 block text-sm font-medium text-gray-700"
            for="email">Email</label
          >
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-navy-500"
          />
        </div>

        <div>
          <label
            class="mb-1 block text-sm font-medium text-gray-700"
            for="password">Password</label
          >
          <input
            id="password"
            name="password"
            type="password"
            required
            minlength="8"
            autocomplete="new-password"
            placeholder="At least 8 characters"
            class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-navy-500"
          />
        </div>

        <div>
          <label
            class="mb-1 block text-sm font-medium text-gray-700"
            for="confirm">Confirm password</label
          >
          <input
            id="confirm"
            name="confirm"
            type="password"
            required
            autocomplete="new-password"
            placeholder="Repeat your password"
            class="w-full rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:border-gray-500 focus:outline-none focus:ring-1 focus:ring-navy-500"
          />
        </div>

        <p
          id="signup-error"
          class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700"
        >
        </p>

        <p
          id="signup-info"
          class="hidden rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800"
        >
        </p>

        <button
          id="signup-submit"
          type="submit"
          class="w-full rounded-lg bg-navy-600 py-2.5 text-sm font-semibold text-white hover:bg-navy-700 disabled:opacity-50"
        >
          Sign up
        </button>

        <p class="text-center text-sm text-gray-500">
          Already have an account?{" "}
          <a
            href="/login"
            class="font-medium text-navy-600 hover:text-navy-700"
          >
            Sign in
          </a>
        </p>
      </div>
    </form>

    <p class="mt-6 text-center text-sm text-gray-500">
      <a href="/" class="font-medium text-gray-600 hover:text-gray-900"
        >← Back to welcome page</a
      >
    </p>
  </div>

  <script>
    const form = document.getElementById(
      "signup-form",
    ) as HTMLFormElement | null;
    const errorEl = document.getElementById("signup-error");
    const infoEl = document.getElementById("signup-info");
    const submitBtn = document.getElementById(
      "signup-submit",
    ) as HTMLButtonElement | null;

    function showError(message: string) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }

    function showInfo(message: string) {
      if (!infoEl) return;
      infoEl.textContent = message;
      infoEl.classList.remove("hidden");
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!errorEl || !infoEl || !submitBtn) return;

      errorEl.classList.add("hidden");
      infoEl.classList.add("hidden");
      submitBtn.disabled = true;

      const data = new FormData(form);
      const name = String(data.get("name") ?? "").trim();
      const email = String(data.get("email") ?? "").trim();
      const password = String(data.get("password") ?? "");
      const confirm = String(data.get("confirm") ?? "");

      try {
        if (!name) throw new Error("Please enter your full name.");
        if (!email) throw new Error("Please enter your email address.");
        if (password.length < 8)
          throw new Error("Password must be at least 8 characters.");
        if (password !== confirm) throw new Error("Passwords do not match.");

        // NOTE: There is no public self-registration endpoint. Accounts are
        // created by an ADMIN/SUPER_ADMIN under Settings → Team (POST
        // /api/v1/users). Don't fake a signup — explain next steps.
        showInfo(
          `Thanks ${name}! Accounts are created by your workspace admin ` +
            "(Settings → Team), not by self-registration — " +
            "please ask your admin to create an account for " +
            `${email}, then sign in.`,
        );
      } catch (err) {
        showError(err instanceof Error ? err.message : "Sign up failed");
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</AuthLayout>
