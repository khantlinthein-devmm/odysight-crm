---
import "../styles/global.css";

const isLoggedIn = Astro.cookies.has("odysight_session");

const features = [
  {
    title: "Leads",
    desc: "Capture, qualify and convert leads with a clean pipeline view.",
    href: "/leads",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    title: "Bookings",
    desc: "Schedule cleanings, assign cleaners and avoid double-booking.",
    href: "/bookings",
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    title: "Customers",
    desc: "Keep every customer, address and preference in one place.",
    href: "/customers",
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
  },
  {
    title: "Cleaners",
    desc: "Manage your cleaning team, roles and availability.",
    href: "/cleaners",
    icon: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  },
  {
    title: "Payments",
    desc: "Track invoices, receipts and monthly revenue at a glance.",
    href: "/payments",
    icon: "M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z",
  },
  {
    title: "Reports",
    desc: "Operational insights for dispatch, accounting and managers.",
    href: "/reports",
    icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Smile Clean CRM — leads, bookings, customers, cleaners, payments and reports in one place."
    />
    <title>Smile Clean CRM — Welcome</title>
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <!-- Nav -->
    <header class="border-b border-gray-200 bg-white/80 backdrop-blur">
      <div
        class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6"
      >
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="flex h-9 w-9 items-center justify-center rounded-xl bg-navy-600"
          >
            <svg
              class="h-5 w-5 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </span>
          <span class="text-base font-semibold tracking-tight"
            >Smile Clean CRM</span
          >
        </a>
        <nav class="flex items-center gap-2 sm:gap-3">
          {
            isLoggedIn ? (
              <a
                href="/dashboard"
                class="rounded-lg bg-navy-600 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700"
              >
                Go to Dashboard
              </a>
            ) : (
              <>
                <a
                  href="/login"
                  class="rounded-lg px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900"
                >
                  Sign in
                </a>
                <a
                  href="/signup"
                  class="rounded-lg bg-navy-600 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700"
                >
                  Get started
                </a>
              </>
            )
          }
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="mx-auto max-w-6xl px-4 pb-10 pt-14 sm:px-6 sm:pt-20">
        <div class="mx-auto max-w-3xl text-center">
          <p
            class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-navy-50 px-3 py-1 text-xs font-medium text-navy-700"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-navy-600"></span>
            Cleaning operations, simplified
          </p>
          <h1
            class="mt-5 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl"
          >
            Welcome to <span class="text-navy-600">Smile Clean CRM</span>
          </h1>
          <p class="mt-4 text-base leading-relaxed text-gray-600 sm:text-lg">
            One workspace for your whole cleaning business — leads, bookings,
            customers, cleaners, service records, payments and reports.
            Sign in to pick up where you left off, or create your workspace
            access.
          </p>
          <div
            class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
          >
            {
              isLoggedIn ? (
                <>
                  <a
                    href="/dashboard"
                    class="w-full rounded-lg bg-navy-600 px-6 py-3 text-sm font-semibold text-white hover:bg-navy-700 sm:w-auto"
                  >
                    Go to Dashboard
                  </a>
                  <a
                    href="/leads"
                    class="w-full rounded-lg border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-100 sm:w-auto"
                  >
                    View Leads
                  </a>
                </>
              ) : (
                <>
                  <a
                    href="/signup"
                    class="w-full rounded-lg bg-navy-600 px-6 py-3 text-sm font-semibold text-white hover:bg-navy-700 sm:w-auto"
                  >
                    Create account
                  </a>
                  <a
                    href="/login"
                    class="w-full rounded-lg border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-700 hover:bg-gray-100 sm:w-auto"
                  >
                    Sign in
                  </a>
                </>
              )
            }
          </div>
          {
            !isLoggedIn && (
              <p class="mt-4 text-sm text-gray-500">
                Already have an account?{" "}
                <a
                  href="/login"
                  class="font-medium text-navy-600 hover:text-navy-700"
                >
                  Sign in here
                </a>
                .
              </p>
            )
          }
        </div>

        <!-- Feature grid -->
        <div
          class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            features.map((f) => (
              <a
                href={f.href}
                class="group rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md"
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-navy-50 text-navy-600">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d={f.icon}
                    />
                  </svg>
                </span>
                <h2 class="mt-4 text-base font-semibold text-gray-900 group-hover:text-navy-700">
                  {f.title}
                </h2>
                <p class="mt-1 text-sm leading-relaxed text-gray-500">
                  {f.desc}
                </p>
                <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-navy-600">
                  Open {f.title.toLowerCase()}
                  <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- CTA band -->
      <section class="border-t border-gray-200 bg-white">
        <div
          class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 px-4 py-10 sm:px-6 lg:flex-row lg:items-center"
        >
          <div>
            <h2 class="text-lg font-semibold text-gray-900">
              Ready to manage today's cleanings?
            </h2>
            <p class="mt-1 text-sm text-gray-500">
              Sign in to access your dashboard, or request access if you're
              new to the team.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href="/login"
              class="rounded-lg bg-navy-600 px-5 py-2.5 text-center text-sm font-semibold text-white hover:bg-navy-700"
            >
              Sign in
            </a>
            <a
              href="/signup"
              class="rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-center text-sm font-semibold text-gray-700 hover:bg-gray-100"
            >
              Sign up
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-gray-200">
      <div
        class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-6 text-xs text-gray-400 sm:flex-row sm:px-6"
      >
        <p>© {new Date().getFullYear()} Smile Clean CRM. All rights reserved.</p>
        <p class="flex gap-4">
          <a href="/login" class="hover:text-navy-600">Sign in</a>
          <a href="/signup" class="hover:text-navy-600">Sign up</a>
          <a href="/dashboard" class="hover:text-navy-600">Dashboard</a>
        </p>
      </div>
    </footer>
  </body>
</html>
