---
import DashboardLayout from "../layouts/DashboardLayout.astro";

const stats = [
  { label: "Total Leads", value: "128", change: "+12%", href: "/leads" },
  {
    label: "Active Customers",
    value: "86",
    change: "+5%",
    href: "/customers",
  },
  {
    label: "Upcoming Bookings",
    value: "42",
    change: "+3%",
    href: "/bookings",
  },
  {
    label: "Revenue (Month)",
    value: "฿245,000",
    change: "+18%",
    href: "/payments",
  },
];
---

<DashboardLayout title="Dashboard">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      stats.map((stat) => (
        <a
          href={stat.href}
          class="rounded-xl border border-slate-200 bg-white p-6 transition-shadow hover:shadow-md"
        >
          <p class="text-sm font-medium text-slate-500">{stat.label}</p>
          <div class="mt-2 flex items-baseline gap-2">
            <p class="text-3xl font-semibold text-slate-900">{stat.value}</p>
            <span class="text-sm font-medium text-emerald-600">
              {stat.change}
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6">
    <h2 class="text-base font-semibold text-slate-900">Recent Activity</h2>
    <p class="mt-4 text-sm text-slate-500">
      Dashboard widgets will appear here once the API layer is connected.
    </p>
  </div>
</DashboardLayout>
