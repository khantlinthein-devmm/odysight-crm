---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page Not Found · Smile Clean CRM</title>
  </head>
  <body
    class="flex min-h-screen flex-col items-center justify-center bg-slate-50 text-slate-900 antialiased"
  >
    <p class="text-7xl font-bold text-indigo-600">404</p>
    <h1 class="mt-4 text-xl font-semibold text-slate-900">Page not found</h1>
    <p class="mt-2 text-sm text-slate-500">
      The page you are looking for doesn't exist or has been moved.
    </p>
    <a
      href="/dashboard"
      class="mt-6 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
    >
      Back to dashboard
    </a>
  </body>
</html>
