const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
---

<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-gray-200 bg-white transition-transform duration-200 lg:translate-x-0"
>
  <div class="sidebar-brand flex h-16 items-center gap-3 border-b border-gray-200 px-6">
    <img
      src="/logo/logo.png"
      alt="Smile Clean logo"
      class="h-9 w-9 shrink-0 rounded-xl bg-white object-contain ring-1 ring-gray-200"
    />
    <span class="nav-label text-lg font-semibold text-gray-900">Smile Clean</span>
  </div>

  <nav id="sidebar-nav" class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          title={item.label}
          data-perm={item.perm}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "nav-link group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
            isActive(item.href)
              ? "bg-navy-50 text-navy-700"
              : "text-gray-600 hover:bg-gray-100 hover:text-gray-900",
          ]}
        >
          <svg
            class:list={[
              "h-5 w-5 shrink-0",
              isActive(item.href)
                ? "text-navy-600"
                : "text-gray-400 group-hover:text-gray-500",
            ]}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d={item.icon}
            />
          </svg>
          <span class="nav-label truncate">{item.label}</span>
        </a>
      ))
    }
  </nav>

  <button
    id="sidebar-collapse"
    type="button"
    class="sidebar-collapse-btn hidden items-center gap-3 border-t border-gray-200 px-6 py-2.5 text-xs font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-800 lg:flex"
    aria-label="Collapse sidebar"
    aria-expanded="true"
  >
    <svg class="sidebar-collapse-icon h-4 w-4 shrink-0 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
    </svg>
    <span class="nav-label">Collapse</span>
  </button>

  <div class="sidebar-user border-t border-gray-200 p-4">
    <div class="flex items-center gap-3">
      <div
        id="sidebar-avatar"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-sm font-semibold text-gray-700"
      >
        ?
      </div>
      <div class="nav-label min-w-0">
        <p
          id="sidebar-name"
          class="truncate text-sm font-medium text-gray-900"
        >
          ...
        </p>
        <p id="sidebar-role" class="truncate text-xs text-gray-500"></p>
      </div>
    </div>
  </div>
</aside>

<script>
  import { getInitials, getSessionUser } from "../../lib/auth";
  import { hasPermission } from "../../lib/roles";

  const user = getSessionUser();

  if (user) {
    // CLEANERs record their own attendance without attendance.read.
    document.querySelectorAll<HTMLElement>("#app-sidebar [data-perm]").forEach((el) => {
      const perm = el.dataset.perm ?? "";
      const selfAttendance = perm === "attendance.read" && user.role === "CLEANER";
      if (!selfAttendance && !hasPermission(user.role, perm)) el.remove();
    });

    const avatar = document.getElementById("sidebar-avatar");
    const name = document.getElementById("sidebar-name");
    const role = document.getElementById("sidebar-role");

    if (avatar) avatar.textContent = getInitials(user.name);
    if (name) name.textContent = user.name;
    if (role) role.textContent = user.role;
  }
</script>

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"
>
</div>

<script>
  const sidebar = document.getElementById("app-sidebar");
  const backdrop = document.getElementById("sidebar-backdrop");
  const openBtn = document.getElementById("sidebar-open");
  const closeBtn = document.getElementById("sidebar-close");

  function open() {
    sidebar?.classList.remove("-translate-x-full");
    backdrop?.classList.remove("hidden");
  }

  function close() {
    sidebar?.classList.add("-translate-x-full");
    backdrop?.classList.add("hidden");
  }

  openBtn?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);

  // Desktop: collapse to an icon rail; the choice is remembered per browser.
  const SIDEBAR_KEY = "smileclean.sidebar";
  const collapseBtn = document.getElementById("sidebar-collapse");
  function syncCollapseButton() {
    const collapsed = document.documentElement.classList.contains("sidebar-collapsed");
    collapseBtn?.setAttribute("aria-expanded", String(!collapsed));
    collapseBtn?.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
    collapseBtn?.setAttribute("title", collapsed ? "Expand sidebar" : "Collapse sidebar");
  }
  collapseBtn?.addEventListener("click", () => {
    const collapsed = document.documentElement.classList.toggle("sidebar-collapsed");
    try {
      localStorage.setItem(SIDEBAR_KEY, collapsed ? "collapsed" : "expanded");
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
    syncCollapseButton();
  });
  syncCollapseButton();

  // Every menu click loads a new page, which would reset the menu's scroll to
  // the top. Remember it across the navigation and restore it on load; if the
  // current page's item is still off-screen, bring it into view.
  const SCROLL_KEY = "smileclean.sidebar.scroll";
  const nav = document.getElementById("sidebar-nav");
  if (nav) {
    try {
      const saved = Number(sessionStorage.getItem(SCROLL_KEY));
      if (saved > 0) nav.scrollTop = saved;
    } catch {
      /* storage blocked */
    }
    const active = nav.querySelector<HTMLElement>('[aria-current="page"]');
    if (active) {
      const a = active.getBoundingClientRect();
      const n = nav.getBoundingClientRect();
      if (a.top < n.top || a.bottom > n.bottom) active.scrollIntoView({ block: "nearest" });
    }
    const save = () => {
      try {
        sessionStorage.setItem(SCROLL_KEY, String(nav.scrollTop));
      } catch {
        /* storage blocked */
      }
    };
    nav.addEventListener("click", save);
    window.addEventListener("pagehide", save);
  }
</script>
