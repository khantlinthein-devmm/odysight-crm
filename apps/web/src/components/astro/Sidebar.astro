const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
---

<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col border-r border-gray-200 bg-white transition-transform duration-200 lg:translate-x-0"
>
  <div class="flex h-16 items-center gap-3 border-b border-gray-200 px-6">
    <img
      src="/logo/logo.png"
      alt="Odysight logo"
      class="h-9 w-9 rounded-xl bg-white object-contain ring-1 ring-gray-200"
    />
    <span class="text-lg font-semibold text-gray-900">Odysight CRM</span>
  </div>

  <nav class="flex-1 space-y-1 overflow-y-auto px-3 py-4">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "group flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition-colors",
            isActive(item.href)
              ? "bg-navy-50 text-navy-700"
              : "text-gray-600 hover:bg-gray-100 hover:text-gray-900",
          ]}
        >
          <svg
            class:list={[
              "h-5 w-5 shrink-0",
              isActive(item.href)
                ? "text-navy-600"
                : "text-gray-400 group-hover:text-gray-500",
            ]}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d={item.icon}
            />
          </svg>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="border-t border-gray-200 p-4">
    <div class="flex items-center gap-3">
      <div
        id="sidebar-avatar"
        class="flex h-9 w-9 items-center justify-center rounded-full bg-gray-100 text-sm font-semibold text-gray-700"
      >
        ?
      </div>
      <div class="min-w-0">
        <p
          id="sidebar-name"
          class="truncate text-sm font-medium text-gray-900"
        >
          ...
        </p>
        <p id="sidebar-role" class="truncate text-xs text-gray-500"></p>
      </div>
    </div>
  </div>
</aside>

<script>
  import { getInitials, getSessionUser } from "../../lib/auth";

  const user = getSessionUser();

  if (user) {
    const avatar = document.getElementById("sidebar-avatar");
    const name = document.getElementById("sidebar-name");
    const role = document.getElementById("sidebar-role");

    if (avatar) avatar.textContent = getInitials(user.name);
    if (name) name.textContent = user.name;
    if (role) role.textContent = user.role;
  }
</script>

<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden"
>
</div>

<script>
  const sidebar = document.getElementById("app-sidebar");
  const backdrop = document.getElementById("sidebar-backdrop");
  const openBtn = document.getElementById("sidebar-open");
  const closeBtn = document.getElementById("sidebar-close");

  function open() {
    sidebar?.classList.remove("-translate-x-full");
    backdrop?.classList.remove("hidden");
  }

  function close() {
    sidebar?.classList.add("-translate-x-full");
    backdrop?.classList.add("hidden");
  }

  openBtn?.addEventListener("click", open);
  closeBtn?.addEventListener("click", close);
  backdrop?.addEventListener("click", close);
</script>
