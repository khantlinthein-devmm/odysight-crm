# Go API base URL. Leave unset during frontend-only development (mock data is used).
# In production this MUST be set, otherwise the app throws at startup.
PUBLIC_API_URL=http://localhost:8080

# Dev-only mock toggle. Mocks never run in production builds regardless of this flag.
# true  = force mocks in dev | false = force API in dev | unset = mocks only when PUBLIC_API_URL is unset
PUBLIC_USE_MOCKS=

# Server-only: the API's JWT_SECRET. Used by the SSR middleware to validate the
# odysight_session cookie signature/expiry. Never reference as PUBLIC_*.
# Must match the API's JWT_SECRET exactly.
# JWT_SECRET=

# Dev-only mock credentials (optional overrides; defaults are local-dev-only).
PUBLIC_MOCK_ADMIN_EMAIL=
PUBLIC_MOCK_ADMIN_PASSWORD=
PUBLIC_MOCK_DISPATCH_EMAIL=
PUBLIC_MOCK_DISPATCH_PASSWORD=
