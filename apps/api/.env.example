APP_ENV=development
PORT=8080

DATABASE_URL=postgres://user:password@localhost:5433/odysight_crm

# Min 32 chars in production. Generate: openssl rand -hex 32
# Production MUST set a unique value via secret manager / deployment env. Never commit real secrets.
# The placeholder below is intentionally rejected by the API in production.
JWT_SECRET=replace-with-openssl-rand-hex-32-output
# Go duration string, e.g. 8h, 30m
JWT_TTL=8h
# Comma-separated allowed browser origins.
# Dev example only. Production MUST set the real frontend origin(s), e.g. https://crm.example.com
CORS_ORIGINS=http://localhost:4321
# Dev-only override for local CORS origin (used only when CORS_ORIGINS is unset and APP_ENV=development)
# DEV_CORS_ORIGIN=http://localhost:4321

# Operational tuning (all optional, defaults shown)
MIGRATIONS_DIR=migrations
RUN_MIGRATIONS=true
RATE_LIMIT_RPM=300
REQUEST_TIMEOUT=30s
READ_HEADER_TIMEOUT=10s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
READY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# Set true to seed initial admin on empty users table.
SEED_ENABLED=false
# Required when SEED_ENABLED=true. No default in production — must be set explicitly.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin User
# Required when SEED_ENABLED=true (min 12 chars in production). Leave empty when not seeding.
SEED_ADMIN_PASSWORD=
# Optional second seed user. Requires SEED_DISPATCH_EMAIL when password is set.
SEED_DISPATCH_EMAIL=
SEED_DISPATCH_NAME=Dispatcher
SEED_DISPATCH_PASSWORD=

# Compose / Postgres (root .env for docker compose; see .env.example if present)
# All required in production — no weak defaults are provided by compose itself.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_PORT=5433
# API_PORT=8080
# API_INTERNAL_PORT=8080
