# Root compose env. Copy to .env and fill per environment. Never commit real secrets.
# Production: provide every required value via deployment secrets, not defaults.

APP_ENV=production

# API container timezone. Sets the attendance work-date rollover hour.
TZ=Asia/Bangkok

POSTGRES_USER=odysight
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=odysight_crm
POSTGRES_PORT=5433

API_PORT=8080
API_INTERNAL_PORT=8080

# postgres://<user>:<password>@postgres:5432/<db> is constructed by compose from above.
# JWT: min 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_TTL=8h

# Comma-separated frontend origin(s), e.g. https://crm.yourdomain.com
CORS_ORIGINS=https://crm.yourdomain.com

SEED_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin User
SEED_DISPATCH_EMAIL=
SEED_DISPATCH_NAME=Dispatcher
SEED_DISPATCH_PASSWORD=

RUN_MIGRATIONS=true
MIGRATIONS_DIR=migrations
# Private proof-of-work photo storage (served only to authenticated staff).
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=8
RATE_LIMIT_RPM=300
LOGIN_RATE_LIMIT_RPM=20
# Comma-separated proxy IPs allowed to set X-Forwarded-For. Defaults to the
# Caddy container's static IP for the bundled proxy setup.
TRUSTED_PROXY_IPS=172.30.0.20
REQUEST_TIMEOUT=30s
READ_HEADER_TIMEOUT=10s
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
READY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# LINE OA → auto-lead (optional; deploy server only — LINE webhooks need
# public HTTPS, they cannot reach localhost/LAN).
# LINE Developers Console → your channel → Messaging API / LINE Login tabs.
# Webhook URL to paste in the console:
#   https://<your-domain>/api/v1/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional one-time auto-reply to first contact (empty = no reply).
# Example: สวัสดีค่ะ ขอบคุณที่ติดต่อ Smile Clean เจ้าหน้าที่จะติดต่อกลับนะคะ
LINE_AUTO_REPLY=

# Web (Astro SSR). PUBLIC_API_URL is the browser-reachable API base URL
# (embedded at web build time).
# Local dev:      http://localhost:8080
# Production:     https://<domain>  (origin only, no /api suffix — the web
#                 app already prefixes every call with /api/v1; Caddy routes
#                 /api/* to the API)
PUBLIC_API_URL=http://localhost:8080
PUBLIC_USE_MOCKS=false
WEB_PORT=4321
WEB_INTERNAL_PORT=4321

# Public entrypoint. Set to your real domain for automatic HTTPS (Let's Encrypt).
# Leave as localhost for plain-HTTP local development.
CADDY_DOMAIN=localhost

# Later: Nginx alternative. See nginx.conf (kept in repo, unused for now).
# Production HTTPS with Nginx: mount certs, enable the 443 block in nginx.conf,
# and set server_name to your real domain there.
